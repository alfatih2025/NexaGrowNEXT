rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isRootAdmin() {
      return isSignedIn() && request.auth.token.email == 'alfatihwibowo264@gmail.com' && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isRootAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email)).data.role == 'admin'
      );
    }
    
    function isAllowedUser() {
      return isRootAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email))
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidAllowedUser(data) {
      return data.keys().hasAll(['email', 'role', 'addedBy', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['admin', 'user'] &&
             data.addedBy is string && data.addedBy.size() <= 128;
    }

    match /allowed_users/{emailId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidAllowedUser(incoming()) && emailId == incoming().email;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
